{
  "//": "산티타이즈된 ~/.claude/settings.json 예시. <...> placeholder를 본인 경로로 교체.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\session-context.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "세션 컨텍스트 로딩 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\ensure-utf8-bom.ps1\"",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\guard-dangerous-bash.ps1\"",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOOKS_DIR>\\plan-guidance.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOOKS_DIR>\\improve-prompt.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CAVEMAN_CACHE>\\caveman-statusline.ps1\""
  },
  "theme": "dark",
  "autoUpdatesChannel": "latest",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true
}
