{
  "//": "산티타이즈된 ~/.claude/settings.json 예시. <...> placeholder를 본인 경로로 교체.",
  "model": "fable[1m]",
  "cleanupPeriodDays": 999999,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\session-context.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "세션 컨텍스트 로딩 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\ensure-utf8-bom.ps1\"",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\guard-dangerous-bash.ps1\"; exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOOKS_DIR>\\plan-guidance.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOOKS_DIR>\\improve-prompt.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"<HOOKS_DIR>\\caveman-reinforce-ultra.js\"",
            "timeout": 5,
            "statusMessage": "caveman ultra 재주입..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "notion@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<HOOKS_DIR>\\caveman-statusline-resolve.ps1\""
  },
  "theme": "dark",
  "autoUpdatesChannel": "latest",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "modelSettings": {
    "claude-fable-5-1": {
      "autoCompactWindow": 300000
    },
    "claude-opus-5-5": {
      "autoCompactWindow": 500000
    }
  },
  "mcpServers": {
    "hwp-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "hwp-mcp@latest"
      ]
    }
  }
}
